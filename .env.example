# YellowMind local development environment
# Copy to .env and adjust as needed: cp .env.example .env

# PostgreSQL
POSTGRES_USER=yellowmind
POSTGRES_PASSWORD=yellowmind
POSTGRES_DB=yellowmind
DATABASE_URL=postgresql://yellowmind:yellowmind@postgres:5432/yellowmind

# MLflow
MLFLOW_PORT=5000

# API
API_PORT=8000

# Prefect
PREFECT_PORT=4200
