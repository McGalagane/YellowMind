# YellowMind local development environment
# Copy to .env and adjust as needed: cp .env.example .env

# PostgreSQL
POSTGRES_USER=yellowmind
POSTGRES_PASSWORD=yellowmind
POSTGRES_DB=yellowmind
# Used by host-side commands (make migrate).
# Docker services connect via the internal hostname "postgres" — see docker-compose.yml.
DATABASE_URL=postgresql://yellowmind:yellowmind@localhost:5432/yellowmind

# MLflow (5001 avoids macOS AirPlay Receiver on port 5000)
MLFLOW_PORT=5001

# API
API_PORT=8000

# Prefect (UI needs PREFECT_UI_API_URL — set automatically in docker-compose.yml)
PREFECT_PORT=4200

# ProCyclingStats ingestion
PCS_USER_AGENT=YellowMind/0.1 (+https://github.com/McGalagane/YellowMind)
PCS_RATE_LIMIT_SECONDS=1.0
PCS_MAX_RETRIES=3
PCS_CACHE_DIR=data/cache/pcs
